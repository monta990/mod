{% set title = __('UI Branding', 'mod') %}
{% set menu = ['config', 'plugin', 'mod'] %}
{% extends 'layout/page_skeleton.html.twig' %}

{% block content %}
{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="container-fluid px-4 mt-3 mod-uibranding-page">
    <div class="card mb-3 mod-version-card">
        <div class="card-body py-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <i class="ti ti-brand-github fs-3 text-muted" aria-hidden="true"></i>
                <strong>{{ __('Installed version', 'mod') }}:</strong>
                <span class="badge bg-secondary-lt text-secondary">{{ version_check.current }}</span>
                {% if version_check.check_available %}
                    <span class="text-muted">{{ __('Latest stable release', 'mod') }}:</span>
                    <span class="badge {{ version_check.update_available ? 'bg-warning-lt text-warning' : 'bg-success-lt text-success' }}">{{ version_check.latest }}</span>
                {% endif %}
                <a href="{{ version_check.releases_url }}" class="btn btn-outline-secondary btn-sm ms-auto"
                   target="_blank" rel="noopener noreferrer">
                    <i class="ti ti-brand-github me-1" aria-hidden="true"></i>{{ __('View releases', 'mod') }}
                </a>
            </div>
            {% if version_check.update_available %}
                <div class="alert alert-warning py-2 mt-3 mb-0 d-flex align-items-center gap-2" role="alert">
                    <i class="ti ti-download" aria-hidden="true"></i>
                    <span>{{ __('A new version is available', 'mod') }}: <strong>{{ version_check.latest }}</strong>.</span>
                </div>
            {% elseif version_check.installed_is_newer %}
                <div class="alert alert-secondary py-2 mt-3 mb-0" role="status">
                    {{ __('Your installed version is newer than the latest stable release published on GitHub.', 'mod') }}
                </div>
            {% elseif not version_check.check_available %}
                <div class="text-muted small mt-2" role="status">
                    {{ __('GitHub version check is currently unavailable. The plugin will retry automatically later.', 'mod') }}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="card mod-main-card">
        <form id="main-form" name="uibranding_form" method="post" action="{{ url }}"
              enctype="multipart/form-data" data-submit-once>

            <div class="card-header mod-section-header">
                <h2 class="card-title mod-section-title ms-5 mb-0">
                    <span class="ribbon ribbon-bookmark ribbon-top ribbon-start bg-blue s-1" aria-hidden="true">
                        <i class="fs-2x ti ti-paint"></i>
                    </span>
                    {{ __('UI Branding', 'mod') }}
                </h2>
            </div>

            <div class="card-body">
                <div class="card mod-section-card">
                    <div class="card-header mod-section-header">
                        <h3 class="card-title mod-section-title ms-5 mb-0">
                            <span class="ribbon ribbon-bookmark ribbon-top ribbon-start bg-blue s-1" aria-hidden="true">
                                <i class="fs-2x ti ti-adjustments"></i>
                            </span>
                            {{ __('Apply Modifications', 'mod') }}
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-12 col-xl-6">
                                {{ fields.textField('title', page_title, __('Page Title', 'mod')) }}
                                {{ fields.dropdownYesNo('show_custom_logos', show_custom_logos, __('Show custom logos', 'mod')) }}
                                {{ fields.dropdownYesNo('show_custom_favicon', show_custom_favicon, __('Show custom favicon', 'mod')) }}
                            </div>
                            <div class="col-12 col-xl-6">
                                {{ fields.dropdownYesNo('show_background', show_background, __('Show login background', 'mod')) }}
                                {{ fields.dropdownYesNo('use_theme_logos', use_theme_logos, __('Enable theme-based logo modifications', 'mod')) }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mod-section-card mt-3">
                    <div class="card-header mod-section-header">
                        <h3 class="card-title mod-section-title ms-5 mb-0">
                            <span class="ribbon ribbon-bookmark ribbon-top ribbon-start bg-blue s-1" aria-hidden="true">
                                <i class="fs-2x ti ti-photo"></i>
                            </span>
                            {{ __('Custom Images', 'mod') }}
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row align-items-center g-3">
                            <div class="col-12 col-xl-6">
                                <div class="form-field row align-items-center">
                                    <label class="col-form-label col-xxl-5 text-xxl-end" for="background_input">
                                        {{ __('Background', 'mod') }} (min. 1920x1080 - JPG)
                                    </label>
                                    <div class="col-xxl-7">
                                        <input type="file" class="form-control" name="background" accept="image/jpeg"
                                               id="background_input" data-mod-preview="preview_background_upload" data-mod-default-preview="preview_background" data-mod-status-preview="status_background_upload" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-xl-6 text-center">
                                <img id="preview_background" class="img-fluid mod-preview-image mod-preview-background"
                                     src="{{ preview_url }}/background?v={{ preview_versions.background }}"
                                     data-mod-default-src="{{ preview_url }}/background?v={{ preview_versions.background }}"
                                     alt="{{ __('Background', 'mod') }}" />
                                <canvas id="preview_background_upload" class="mod-preview-canvas mod-preview-background" data-mod-max-width="960" data-mod-max-height="540" role="img" hidden></canvas>
                                <div id="status_background_upload" class="mod-preview-status" role="status" aria-live="polite" hidden></div>
                            </div>

                            <div class="col-12"><hr class="my-2" /></div>

                            <div class="col-12 col-xl-6">
                                <div class="form-field row align-items-center">
                                    <label class="col-form-label col-xxl-5 text-xxl-end" for="favicon_input">
                                        {{ __('Favicon', 'mod') }} (16x16 - ICO)
                                    </label>
                                    <div class="col-xxl-7">
                                        <input type="file" class="form-control" name="favicon" accept=".ico,image/x-icon"
                                               id="favicon_input" data-mod-preview="preview_favicon_upload" data-mod-default-preview="preview_favicon" data-mod-status-preview="status_favicon_upload" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-xl-6 text-center">
                                <img id="preview_favicon" class="mod-preview-image mod-preview-favicon"
                                     src="{{ preview_url }}/favicon?v={{ preview_versions.favicon }}"
                                     data-mod-default-src="{{ preview_url }}/favicon?v={{ preview_versions.favicon }}"
                                     alt="{{ __('Favicon', 'mod') }}" />
                                <canvas id="preview_favicon_upload" class="mod-preview-canvas mod-preview-favicon" data-mod-max-width="128" data-mod-max-height="128" role="img" hidden></canvas>
                                <div id="status_favicon_upload" class="mod-preview-status" role="status" aria-live="polite" hidden></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="default-logos-section" class="card mod-section-card mt-3" {% if use_theme_logos %}style="display:none"{% endif %}>
                    <div class="card-header mod-section-header">
                        <h3 class="card-title mod-section-title ms-5 mb-0">
                            <span class="ribbon ribbon-bookmark ribbon-top ribbon-start bg-blue s-1" aria-hidden="true">
                                <i class="fs-2x ti ti-brand-abstract"></i>
                            </span>
                            {{ __('Standard logos', 'mod') }}
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row row-cards g-3">
                            {% for logo in base_logos %}
                                <div class="col-12">
                                    <div class="row align-items-center g-3">
                                        <div class="col-12 col-xl-7">
                                            <div class="form-field row align-items-center">
                                                <label class="col-form-label col-xxl-5 text-xxl-end" for="{{ logo.name }}_input">
                                                    {{ logo.label }} ({{ logo.size }} - PNG)
                                                </label>
                                                <div class="col-xxl-7">
                                                    <input type="file" class="form-control" name="{{ logo.name }}" accept="image/png"
                                                           id="{{ logo.name }}_input" data-mod-preview="preview_{{ logo.name }}_upload" data-mod-default-preview="preview_{{ logo.name }}" data-mod-status-preview="status_{{ logo.name }}_upload" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-xl-5 text-center">
                                            <img id="preview_{{ logo.name }}" class="img-fluid mod-preview-image mod-preview-logo"
                                                 src="{{ preview_url }}/{{ logo.name }}?v={{ preview_versions[logo.name] }}"
                                                 data-mod-default-src="{{ preview_url }}/{{ logo.name }}?v={{ preview_versions[logo.name] }}"
                                                 alt="{{ logo.label }}" />
                                            <canvas id="preview_{{ logo.name }}_upload" class="mod-preview-canvas mod-preview-logo" data-mod-max-width="640" data-mod-max-height="360" role="img" hidden></canvas>
                                            <div id="status_{{ logo.name }}_upload" class="mod-preview-status" role="status" aria-live="polite" hidden></div>
                                        </div>
                                    </div>
                                </div>
                                {% if not loop.last %}<div class="col-12"><hr class="my-0" /></div>{% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <div id="theme-logos-section" class="card mod-section-card mt-3" {% if not use_theme_logos %}style="display:none"{% endif %}>
                    <div class="card-header mod-section-header">
                        <h3 class="card-title mod-section-title ms-5 mb-0">
                            <span class="ribbon ribbon-bookmark ribbon-top ribbon-start bg-blue s-1" aria-hidden="true">
                                <i class="fs-2x ti ti-palette"></i>
                            </span>
                            {{ __('Theme-based logos', 'mod') }}
                        </h3>
                    </div>
                    <div class="card-body">
                        <div class="row row-cards g-3">
                            {% for logo in theme_logos %}
                                <div class="col-12">
                                    <div class="row align-items-center g-3">
                                        <div class="col-12 col-xl-7">
                                            <div class="form-field row align-items-center">
                                                <label class="col-form-label col-xxl-5 text-xxl-end" for="{{ logo.name }}_input">
                                                    {{ logo.label }} ({{ logo.size }} - PNG)
                                                </label>
                                                <div class="col-xxl-7">
                                                    <input type="file" class="form-control" name="{{ logo.name }}" accept="image/png"
                                                           id="{{ logo.name }}_input" data-mod-preview="preview_{{ logo.name }}_upload" data-mod-default-preview="preview_{{ logo.name }}" data-mod-status-preview="status_{{ logo.name }}_upload" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 col-xl-5 text-center">
                                            <img id="preview_{{ logo.name }}" class="img-fluid mod-preview-image mod-preview-logo"
                                                 src="{{ preview_url }}/{{ logo.name }}?v={{ preview_versions[logo.name] }}"
                                                 data-mod-default-src="{{ preview_url }}/{{ logo.name }}?v={{ preview_versions[logo.name] }}"
                                                 alt="{{ logo.label }}" />
                                            <canvas id="preview_{{ logo.name }}_upload" class="mod-preview-canvas mod-preview-logo" data-mod-max-width="640" data-mod-max-height="360" role="img" hidden></canvas>
                                            <div id="status_{{ logo.name }}_upload" class="mod-preview-status" role="status" aria-live="polite" hidden></div>
                                        </div>
                                    </div>
                                </div>
                                {% if not loop.last %}<div class="col-12"><hr class="my-0" /></div>{% endif %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-between align-items-center gap-2">
                <button class="btn btn-outline-secondary" type="submit" name="clear_cache" value="1" formnovalidate>
                    <i class="ti ti-refresh me-1" aria-hidden="true"></i>
                    {{ __('Clear cache', 'mod') }}
                </button>
                <button class="btn btn-primary" type="submit" name="update" value="1">
                    <i class="ti ti-device-floppy me-1" aria-hidden="true"></i>
                    {{ _x('button', 'Save') }}
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    /* GLPI may wrap plugin content in a breakpoint-constrained `.container`.
     * Keep this configuration page at the full available width. */
    .page-body > .container.container-fluid {
        width: 100%;
        max-width: none;
    }


    .mod-uibranding-page {
        width: 100%;
        margin-bottom: 0;
    }

    .mod-main-card {
        width: 100%;
        max-width: none;
    }

    .mod-section-card {
        width: 100%;
        border-color: var(--tblr-border-color);
        box-shadow: none;
    }

    .mod-section-header {
        position: relative;
        min-height: 2.75rem;
        padding-top: .65rem;
        padding-bottom: .65rem;
    }

    .mod-section-title {
        color: var(--tblr-body-color);
        font-weight: 500;
        line-height: 1.35;
    }

    .mod-section-title .ribbon {
        color: #fff;
    }

    .mod-preview-image,
    .mod-preview-canvas {
        display: block;
        max-width: 100%;
        width: auto;
        height: auto;
        margin-inline: auto;
        object-fit: contain;
    }

    .mod-preview-background {
        max-height: 220px;
    }

    .mod-preview-logo {
        max-height: 180px;
    }

    .mod-preview-favicon {
        width: 64px;
        height: 64px;
        image-rendering: auto;
    }

    .mod-preview-status {
        display: block;
        width: 100%;
        max-width: 100%;
        margin-inline: auto;
        padding: .75rem;
        color: var(--tblr-body-color);
        line-height: 1.4;
        text-align: center;
        overflow-wrap: anywhere;
        border: 1px dashed var(--tblr-border-color);
        border-radius: var(--tblr-border-radius);
        background-color: var(--tblr-bg-surface-secondary);
    }

    .mod-preview-image[hidden],
    .mod-preview-canvas[hidden],
    .mod-preview-status[hidden] {
        display: none !important;
    }

    @media (min-width: 1200px) {
        .mod-preview-logo {
            max-height: 150px;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const selector = document.querySelector("select[name='use_theme_logos']");
        const themeSection = document.getElementById('theme-logos-section');
        const standardSection = document.getElementById('default-logos-section');

        if (!selector || !themeSection || !standardSection) {
            return;
        }

        const updateSections = () => {
            const enabled = selector.value === '1';
            themeSection.style.display = enabled ? '' : 'none';
            standardSection.style.display = enabled ? 'none' : '';
        };

        selector.addEventListener('change', updateSections);
        updateSections();
    });
</script>
{% endblock content %}
